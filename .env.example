# ── Required ─────────────────────────────────────────────
# Admin panel password (use something long & unique)
ADMIN_PASSWORD=change-this-to-a-strong-password
# Random long string used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string

# ── Optional ─────────────────────────────────────────────
PORT=3000
# If set, all content is stored in MongoDB (recommended on Render/Railway,
# because their free disks are wiped on every redeploy).
# Free cluster: https://www.mongodb.com/atlas
MONGODB_URI=
MONGODB_DB=portfolio
